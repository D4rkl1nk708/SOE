# Dependências
node_modules/
.pnp
.pnp.js

# Builds e Releases locais
dist/
build/
release/
bin/
obj/

# Variáveis de ambiente (NUNCA commitar!)
.env
.env.*
!.env.example

# Scraper (contém credenciais e dados locais)
tec-scraper/

# Conversas com IA / Assistentes
*.conversation
.gemini/
.cursor/
.copilot/
.aider*

# Scratch / Testes temporários
scratch/
test_output.txt
patch_essays.py

# Logs e arquivos de sistema
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db

# Relatórios e cobertura
data/
playwright-report/
test-results/
coverage/

# Binários e instaladores (usar GitHub Releases em vez de commitar)
*.apk
*.aab
*.msi
*.exe
*.dmg
*.AppImage
*.deb
*.rpm

# Backups e dumps de dados
soe-backup-*.json
*.backup.json

# Android Studio
android/.idea/

# Assinatura de release do Android (credenciais locais, NUNCA commitar).
# O debug.keystore continua versionado de propósito (build de debug e CI).
android/keystore.properties
android/*.keystore
!android/debug.keystore
*.jks

# Ignore only the Capacitor-generated assets (not the whole assets dir)
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/**/.cxx/
android/**/.externalNativeBuild/
*.iml

# Electron preload gerado automaticamente (gerado via build.cjs)
electron/tec-preload.cjs
